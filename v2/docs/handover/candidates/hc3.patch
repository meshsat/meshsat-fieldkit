+    correction the reading cites is byte-identical to the base commit's (the layer-1 closer's method)."""
+    path, old = op["path"], op["old_sha"]
+    cur = sha16_text(file_text(path))
+    field = doc.get_field("records", op["id"], "evidence_bound_to") or ""
+    if cur == old:
+        return "unchanged"
+    if "%s@%s" % (path, cur) in field:
+        return "skip"
+    if "%s@%s" % (path, old) not in field:
+        return "HAND RE-READ (bound to %s neither at %s nor at this tree's %s)" % (path, old, cur)
+    base_lines = subprocess.run(["git", "-C", ROOT_FOR_OPS[0], "show", "%s:%s" % (BASE_COMMIT, path)],
+                                capture_output=True, text=True).stdout.split("\n")
+    new_lines = file_text(path).split("\n")
+    for ln in op.get("lines", []):
+        if base_lines[ln - 1] != new_lines[ln - 1]:
+            return "HAND RE-READ (%s line %d changed since %s)" % (path, ln, BASE_COMMIT)
+    for c in op.get("corrections", []):
+        if correction_line(base_lines, c) != correction_line(new_lines, c):
+            return "HAND RE-READ (%s correction %d changed since %s)" % (path, c, BASE_COMMIT)
+    doc.set_field("records", op["id"], "evidence_bound_to", field, field.replace("%s@%s" % (path, old), "%s@%s" % (path, cur)))
+    doc.append_list_item("records", op["id"], "evidence", item_text(op["evidence"].replace("{SHA}", cur)),
+                         op["evidence"][:60])
+    return "applied"
+
+
+def item_text(text):
+    import textwrap
+    return "\n".join(["      - >-"] + [" " * 10 + l for l in textwrap.wrap(" ".join(text.split()), width=110,
+                                                                           break_long_words=False, break_on_hyphens=False)])
+
+
+def op_swap(op):
+    """Replace another closer's SC placeholders in its own files with the ids this script assigned."""
+    done = []
+    for path in op["files"]:
+        p = os.path.join(ROOT_FOR_OPS[0], path)
+        if not os.path.exists(p):
+            continue
+        t = file_text(path); t0 = t
+        for k, v in op["map"].items():
+            t = t.replace(k, v)
+        if t != t0:
+            done.append(path)
+            OVERLAY[path] = t
+            if WRITE_FILES[0]:
+                open(p, "w", encoding="utf-8").write(t)
+    return "applied" if done else "skip"
+
+
+# ---- readings re-read at integration ---------------------------------------------------------------------------
+def md_section(text, prefix):
+    L = text.split("\n")
+    for i, l in enumerate(L):
+        m = re.match(r"^(#+) (.*)", l)
+        if m and m.group(2).startswith(prefix):
+            lvl = len(m.group(1)); j = i + 1
+            while j < len(L):
+                m2 = re.match(r"^(#+) ", L[j])
+                if m2 and len(m2.group(1)) <= lvl:
+                    break
+                j += 1
+            return "\n".join(L[i:j])
+    return None
+
+
+def revision_with_sha(path, sha16):
+    """The content of `path` at the revision whose sha256/16 is `sha16`: the base commit, then the file's history."""
+    cands = [BASE_COMMIT]
+    r = subprocess.run(["git", "-C", ROOT_FOR_OPS[0], "log", "--format=%H", "-n", "400", "--all", "--", path],
+                       capture_output=True, text=True)
+    cands += r.stdout.split()
+    for c in cands:
+        s = subprocess.run(["git", "-C", ROOT_FOR_OPS[0], "show", "%s:%s" % (c, path)], capture_output=True)
+        if s.returncode == 0 and hashlib.sha256(s.stdout).hexdigest()[:16] == sha16:
+            return s.stdout.decode("utf-8")
+    return None
+
+
+def op_rebind_if_same(doc, op):
+    """Rebind one path of a reading when every anchor the reading rests on is byte-identical between the revision it is
+    bound to and this tree: markdown sections by heading, lines and paragraphs taken from the bound revision, or text
+    that must be present. Anything else is left for a hand re-read (the validator then flags the stale binding)."""
+    rid, path = op["id"], op["path"]
+    field = doc.get_field("records", rid, "evidence_bound_to") or ""
+    m = re.search(re.escape(path) + r"@([0-9a-f]{16})", field)
+    if not m:
+        return "no binding"
+    old = m.group(1); cur = sha16_text(file_text(path))
+    if old == cur:
+        return "unchanged"
+    was = revision_with_sha(path, old)
+    if was is None:
+        return "HAND RE-READ (bound revision %s not found)" % old
+    now = file_text(path)
+    for pre in op.get("sections", []):
+        a, b = md_section(was, pre), md_section(now, pre)
+        if a is None or a != b:
+            return "HAND RE-READ (section %s changed)" % pre
+    for pre in op.get("lines_from_bound", []):
+        hits = [l for l in was.split("\n") if l.startswith(pre)]
+        if not hits or any(h not in now.split("\n") for h in hits):
+            return "HAND RE-READ (line %r changed)" % pre[:30]
+    for pre in op.get("paras_from_bound", []):
+        hits = [q for q in was.split("\n\n") if q.startswith(pre)]
+        if not hits or any(h not in now for h in hits):
+            return "HAND RE-READ (paragraph %r changed)" % pre[:30]
+    for s in op.get("contains", []):
+        if s not in now:
+            return "HAND RE-READ (%r absent)" % s[:30]
+    for pre in op.get("table_rows_from_bound", []):
+        # every table row of the bound revision's section `pre` (headings compared by prefix) is in the tree as it was
+        sec = md_section(was, pre)
+        rows = [l for l in (sec or "").split("\n") if l.startswith("|")]
+        if not rows or any(r not in now.split("\n") for r in rows):
+            return "HAND RE-READ (a table row of section %s changed)" % pre
+    doc.set_field("records", rid, "evidence_bound_to", field, field.replace("%s@%s" % (path, old), "%s@%s" % (path, cur)))
+    if op.get("evidence"):
+        # a re-read the closer did by hand on the merged files; the anchors above guard that the text it read is there
+        text = op["evidence"].replace("{OLD}", old).replace("{SHA}", cur)
+    else:
+        what = "; ".join([("section " + s) for s in op.get("sections", [])] + [("the line or row beginning %r" % s[:40]) for s in
+                         op.get("lines_from_bound", [])] + [("the paragraph beginning %r" % s[:40]) for s in
+                         op.get("paras_from_bound", [])] + [("the text %r" % s[:50]) for s in op.get("contains", [])] +
+                         [("every table row of section %s" % s) for s in op.get("table_rows_from_bound", [])])
+        text = ("%s re-read at integration by the layer-3 closer's apply script (27 September 2026): %s, which this reading "
+                "rests on, byte-identical to the revision it was bound to (%s), so it stands on the file at %s"
+                % (path, what, old, cur))
+    doc.append_list_item("records", rid, "evidence", item_text(text), "%s at %s" % (path.split("/")[-1], cur))
+    return "applied"
+
+
+def testplan_trace_ok(text):
+    """Every table with Purpose and Verifies columns has both in every row, and section 4 carries its trace."""
+    hdr = None; rows = 0
+    for l in text.split("\n"):
+        if l.startswith("|") and "Purpose" in l and "Verifies" in l:
+            hdr = [c.strip() for c in l.strip("|").split("|")]; continue
+        if hdr and l.startswith("|") and not l.startswith("|---"):
+            cells = [c.strip() for c in l.strip("|").split("|")]
+            if len(cells) != len(hdr):
+                return False, "a row with %d cells under %d headings" % (len(cells), len(hdr))
+            d = dict(zip(hdr, cells)); rows += 1
+            if not d["Purpose"] or not d["Verifies"]:
+                return False, "a row without its purpose or its requirement: %s" % cells[0]
+        elif not l.startswith("|"):
+            hdr = None
+    s4 = md_section(text, "4.") or ""
+    if "Purpose and trace" not in s4:
+        return False, "section 4 carries no trace"
+    return rows > 0, "%d rows" % rows
+
+
+def op_reading_if(doc, op):
+    path = op["path"]; now = file_text(path); cur = sha16_text(now)
+    note = ""
+    if op.get("require_sha"):
+        # a reading taken BY HAND on one revision of the file: written only on that revision (or on it with the
+        # placeholders this script fills put back), never on another the hand reading did not see
+        was = now
+        for new_t, old_t in op.get("unswap", []):
+            was = was.replace(new_t, old_t)
+        if sha16_text(was) != op["require_sha"]:
+            return "HAND RE-READ (%s is %s; the hand reading was of %s)" % (path, cur, op["require_sha"])
+    if op.get("check") == "testplan_trace":
+        ok, note = testplan_trace_ok(now)
+        if not ok:
+            return "absent (%s)" % note
+    for s in op.get("contains", []):
+        if s not in now:
+            return "absent"
+    rid = op["id"]
+    bound = doc.get_field("records", rid, "evidence_bound_to") or ""
+    if "%s@%s" % (path, cur) in bound and norm(op["result"]) in norm(doc.get_field("records", rid, "evidence_result") or ""):
+        return "skip"
+    if op.get("status"):
+        doc.set_field("records", rid, "status", doc.get_field("records", rid, "status"), "    status: %s" % op["status"])
+    if op.get("resolved_by"):
+        cur_rb = doc.get_field("records", rid, "resolved_by")
+        doc.set_field("records", rid, "resolved_by", cur_rb, "    resolved_by: >-\n" + "\n".join(
+            "      " + x for x in __import__("textwrap").wrap(" ".join(op["resolved_by"].split()), 112)), after="status")
+    doc.set_field("records", rid, "evidence_result", doc.get_field("records", rid, "evidence_result"),
+                  "    evidence_result: %s" % op["result"])
+    if doc.get_field("records", rid, "evidence_phase") is None:
+        doc.set_field("records", rid, "evidence_phase", None, "    evidence_phase: SCHEMATIC", after="evidence_result")
+    ec = doc.get_field("records", rid, "evidence_class")
+    doc.set_field("records", rid, "evidence_class", ec, "    evidence_class: DESK_REVIEW", after="evidence_phase")
+    text = op["evidence"].replace("{SHA}", cur).replace("{NOTE}", note)
+    if doc.get_field("records", rid, "evidence") is None:
+        doc.set_field("records", rid, "evidence", None, "    evidence:\n" + item_text(text), after="evidence_class")
+    else:
+        doc.append_list_item("records", rid, "evidence", item_text(text), text[:70])
+    nb = '    evidence_bound_to:\n      - "%s@%s"' % (path, cur)
+    doc.set_field("records", rid, "evidence_bound_to", doc.get_field("records", rid, "evidence_bound_to"), nb,
+                  after="evidence")
+    return "applied"
+
+
+def op_replace_in_block(doc, op):
+    for bid, bs, be in doc.blocks(op["section"]):
+        bt = "\n".join(doc.lines[bs:be])
+        if norm(op["fingerprint"]) in norm(bt):
+            if norm(op["new"]) in norm(bt):
+                return "skip"
+            f = doc.get_field(op["section"], bid, op["field"])
+            if f is None or norm(op["old"]) not in norm(f):
+                return "absent (text moved)"
+            nf = re.sub(r"\s+", " ", f)
+            new_body = norm(f).replace(norm(op["old"]), norm(op["new"]))
+            key = op["field"]
+            doc.set_field(op["section"], bid, key, f, "    %s: >-\n" % key + "\n".join(
+                "      " + x for x in __import__("textwrap").wrap(new_body.split(":", 1)[1].replace(">-", "", 1).strip(), 112)))
+            return "applied"
+    return "absent"
+
+
+def op_file_swap(op):
+    """One exact phrase in a document another closer owns, filled with the id this script assigned (the phrase is that
+    closer's own placeholder for the registry writer)."""
+    path = op["path"]
+    p = os.path.join(ROOT_FOR_OPS[0], path)
+    if not os.path.exists(p):
+        return "absent"
+    t = file_text(path)
+    if op["new"] in t and op["old"] not in t:
+        return "skip"
+    if t.count(op["old"]) != 1:
+        return "absent (phrase found %d times)" % t.count(op["old"])
+    t = t.replace(op["old"], op["new"])
+    OVERLAY[path] = t
+    if WRITE_FILES[0]:
+        open(p, "w", encoding="utf-8").write(t)
+    return "applied"
+
+
+# ---- documents the records cite, filed from the closers' drafts ------------------------------------------------
+HERE_SCRIPT = os.path.dirname(os.path.abspath(__file__))
+INSTALLED = set()
+
+
+def run_vendor(root, vops, log, write):
+    """Files each cited document from the drafts beside this script (sha256 checked both ways) and appends each
+    SOURCES.yaml block once. A target that exists with other content refuses: someone filed a different file there."""
+    for v in vops:
+        if v["op"] == "install_file":
+            src = os.path.join(HERE_SCRIPT, v["src"]); dst = os.path.join(root, v["dst"])
+            data = open(src, "rb").read()
+            if hashlib.sha256(data).hexdigest() != v["sha256"]:
+                raise Refused("draft %s is not the file this script was written for (sha256 differs)" % v["src"])
+            if os.path.exists(dst):
+                if hashlib.sha256(open(dst, "rb").read()).hexdigest() != v["sha256"]:
+                    raise Refused("%s exists with other content; read it before filing the draft over it" % v["dst"])
+                log.append(("skip", "file document", v["dst"][-40:], "")); INSTALLED.add(v["dst"]); continue
+            if write:
+                os.makedirs(os.path.dirname(dst), exist_ok=True)
+                open(dst, "wb").write(data)
+            INSTALLED.add(v["dst"])
+            log.append(("applied", "file document", v["dst"][-40:], v["sha256"][:16]))
+        elif v["op"] == "append_block":
+            src = os.path.join(HERE_SCRIPT, v["src"]); path = v["path"]
+            block = open(src, encoding="utf-8").read()
+            if hashlib.sha256(block.encode("utf-8")).hexdigest() != v["sha256"]:
+                raise Refused("draft %s is not the block this script was written for (sha256 differs)" % v["src"])
+            t = file_text(path)
+            if re.search(r"^%s\s*$" % re.escape(v["key"]), t, re.M):
+                log.append(("skip", "sources block", v["key"], "")); continue
+            t = t.rstrip("\n") + "\n\n" + block.rstrip("\n") + "\n"
+            OVERLAY[path] = t
+            if write:
+                open(os.path.join(root, path), "w", encoding="utf-8").write(t)
+            log.append(("applied", "sources block", v["key"], path))
+
+
+def prune_companions(doc, root, log):
+    """companion_documents lists cited files that are not filed yet; once a file is filed it leaves the list, so the
+    validator's existence check covers it again."""
+    for i, l in enumerate(doc.lines):
+        if l.startswith("companion_documents:"):
+            j = i + 1; items = []
+            while j < len(doc.lines) and doc.lines[j].startswith("  - "):
+                items.append(doc.lines[j][4:].strip().strip('"')); j += 1
+            keep = [x for x in items if not (x in INSTALLED or os.path.exists(os.path.join(root, x)))]
+            if keep == items:
+                log.append(("skip", "companions", "%d listed" % len(items), "")); return
+            new = ["companion_documents: []"] if not keep else ["companion_documents:"] + ['  - "%s"' % x for x in keep]
+            doc.lines[i:j] = new
+            log.append(("applied", "companions", "%d filed" % (len(items) - len(keep)), "%d still listed" % len(keep)))
+            return
+
+
+def run_ops(doc, ops, log):
+    for op in ops:
+        k = op["op"]
+        if k == "file_swap":
+            log.append((op_file_swap(op), k, op["path"][-22:], op["new"][:40]))
+            continue
+        if k == "when_file_contains":
+            if op["text"] in file_text(op["path"]):
+                run_ops(doc, [op["then"]], log)
+            else:
+                log.append(("absent", "when_file_contains", op["then"].get("id", ""), op["path"]))
+            continue
+        if k == "rebind_if_unchanged":
+            log.append((op_rebind(doc, op, log), k, op["id"], op["path"]))
+            continue
+        if k == "swap_placeholders":
+            log.append((op_swap(op), k, "files", ", ".join(op["files"])[:40]))
+            continue
+        if k == "rebind_if_same":
+            log.append((op_rebind_if_same(doc, op), k, op["id"], op["path"]))
+            continue
+        if k == "reading_if":
+            log.append((op_reading_if(doc, op), k, op["id"], op["path"]))
+            continue
+        if k == "replace_in_block":
+            log.append((op_replace_in_block(doc, op), k, op["section"], op["field"]))
+            continue
+        if k == "set_any":
+            cur = doc.get_field(op["section"], op["id"], op["field"])
+            if norm(cur) == norm(op["new"]):
+                r = "skip"
+            else:
+                hit = [o for o in op["olds"] if norm(o) == norm(cur)]
+                if not hit:
+                    raise Refused("%s %s field %s: none of the %d texts it expects is there; it reads: %s"
+                                  % (op["section"], op["id"], op["field"], len(op["olds"]), norm(cur)[:300]))
+                r = doc.set_field(op["section"], op["id"], op["field"], cur, op["new"])
+            log.append((r, k, op["id"], op["field"]))
+            continue
+        if k == "set":
+            r = doc.set_field(op["section"], op["id"], op["field"], op.get("old"), op.get("new"), after=op.get("after"))
+        elif k == "replace_in_field":
+            r = doc.replace_in_field(op["section"], op["id"], op["field"], op["old"], op["new"])
+        elif k == "append_item":
+            r = doc.append_list_item(op["section"], op["id"], op["field"], op["text"], op["fingerprint"])
+        elif k == "list_add":
+            r = op_list_add(doc, op["section"], op["id"], op["field"], op["item"], op.get("after"))
+        elif k == "list_remove":
+            r = op_list_remove(doc, op["section"], op["id"], op["field"], op["item"])
+        elif k == "rules_add":
+            r = op_rules_add(doc, op["section"], op["id"], op["rule"])
+        elif k == "add_block":
+            r = doc.add_block(op["section"], op["text"], after=op.get("after"), fingerprint=op["fingerprint"])
+        elif k == "remove_block":
+            r = doc.remove_block(op["section"], op["id"], op["must_contain"])
+        elif k == "top":
+            r = doc.set_top(op["key"], op.get("old"), op["new"])
+        elif k == "header":
+            r = doc.replace_text(op["old"], op["new"])
+        elif k == "link_choice_if_present":
+            hit = [b for b in doc.blocks("session_choices")
+                   if norm(op["question_fingerprint"]) in norm("\n".join(doc.lines[b[1]:b[2]]))
+                   and "withdrawn_on" not in "\n".join(doc.lines[b[1]:b[2]])]
+            r = op_list_add(doc, op["section"], op["id"], "choices", hit[0][0], op.get("after")) if hit else "absent"
+        else:
+            raise Refused("unknown op %s" % k)
+        log.append((r, k, op.get("id") or op.get("key") or op.get("section"), op.get("field") or ""))
+
+
+def reanchor(doc, root, log, accept_rewritten):
+    """Every file:line in every `source` field, from the commit sources_read_at names to this tree. Only citations known
+    to have been read at that commit are moved: those the registry of the base commit already carried in the same
+    record (when sources_read_at is the base registry's) or that the registry at HEAD carries (otherwise). A citation a
+    later writer added is left where it is and listed. A citation whose text was rewritten where it stood is carried
+    positionally and listed for a hand re-read; in a superseded or conflict record it keeps its old line and names the
+    commit it was read at, since those records cite what a source SAID."""
+    frm = None
+    for l in doc.lines:
+        if l.startswith("sources_read_at:"):
+            frm = l.split(":", 1)[1].strip()
+    to = head(root)
+    if not frm or not to:
+        raise Refused("reanchor needs git and a sources_read_at")
+    if frm == to:
+        log.append(("skip", "reanchor", frm, "already at HEAD"))
+        return []
+    reg_path = "v2/ecad/tools/pcb_requirements.yaml"
+    known_src = None
+    for c in (BASE_COMMIT, "HEAD"):
+        s = subprocess.run(["git", "-C", root, "show", "%s:%s" % (c, reg_path)], capture_output=True, text=True)
+        if s.returncode == 0 and ("sources_read_at: %s" % frm) in s.stdout:
+            known_src = Doc(s.stdout); break
+    if known_src is None:
+        raise Refused("no committed registry says sources_read_at: %s, so which citations were read there is unknown" % frm)
+    # sources_read_at will name HEAD, so every cited file must BE HEAD's: a merge left uncommitted would be read here
+    # and then attributed to a commit that does not hold it. The files this script edits in place are exempt (their
+    # edits keep every line where it was, which author.py asserts).
+    cited = sorted(set(m.group(1) for m in CITE.finditer(doc.text())))
+    own = set(f["path"] for f in FILE_OPS)
+    dirty = [p for p in cited if p not in own and os.path.exists(os.path.join(root, p)) and
+             subprocess.run(["git", "-C", root, "diff", "--quiet", "HEAD", "--", p]).returncode != 0]
+    if dirty:
+        msg = ("%d cited file(s) differ from HEAD (%s): commit the merged documents first, then run this script, so "
+               "sources_read_at names the commit that holds what was read" % (len(dirty), ", ".join(dirty[:6])))
+        if not DRY_RUN[0]:
+            raise Refused(msg)
+        log.append(("WARN", "reanchor", "uncommitted", msg[:200]))
+    fo, fn, mp, rewritten, left = {}, {}, {}, [], []
+    # the documents this run changed in memory (a dry run writes nothing) are read as they will be written
+    for p_, t_ in OVERLAY.items():
+        old_ = git_show(root, frm, p_)
+        if old_ is not None:
+            fo[p_], fn[p_] = old_, t_.split("\n")
+            mp[p_] = line_map(fo[p_], fn[p_])
+    anchors = {}
+    for a_ in CITE_ANCHORS:
+        anchors[(a_["id"], a_["cite"])] = a_
+    for sec in SECTIONS:
+        known_ids = set(known_src.ids(sec))
+        for bid, bs, be in doc.blocks(sec):
+            cur = doc.get_field(sec, bid, "source")
+            if not cur:
+                continue
+            base_field = known_src.get_field(sec, bid, "source") if bid in known_ids else ""
+            known = set(m.group(0) for m in CITE.finditer(base_field or ""))
+            kind = doc.get_field(sec, bid, "kind") or ""
+            historical = "superseded" in kind or "conflict" in kind
+
+            def one(m):
+                if m.group(0) not in known:
+                    left.append("%s %s %s (added after %s's registry)" % (sec, bid, m.group(0), frm))
+                    return m.group(0)
+                an = anchors.get((bid, m.group(0))) if frm == CITE_ANCHOR_FROM else None
+                if an:
+                    # a citation whose passage moved AND was rewritten around it: found by its own opening text
+                    path_ = m.group(1)
+                    lines_ = fn.get(path_)
+                    if lines_ is None:
+                        try:
+                            lines_ = open(os.path.join(root, path_), encoding="utf-8").read().split("\n")
+                        except OSError:
+                            lines_ = []
+                    for start, n in an["anchors"]:
+                        hits = [i for i, l in enumerate(lines_) if l.startswith(start)]
+                        if len(hits) == 1:
+                            log.append(("applied", "reanchor", "%s %s" % (bid, path_.split("/")[-1]),
+                                        "anchored at %d-%d" % (hits[0] + 1, hits[0] + n)))
+                            return "%s:%d-%d" % (path_, hits[0] + 1, hits[0] + n)
+                    left.append("%s %s %s (its anchor text is not found once)" % (sec, bid, m.group(0)))
+                    return m.group(0)
+                new, notes = reanchor_source_entry(m.group(0) + '"', root, frm, fo, fn, mp, historical=historical)
+                for (p, a, b, how) in notes:
+                    if how == "rewritten in place":
+                        rewritten.append("%s %s %s:%d-%d%s" % (sec, bid, p, a, b, " (kept, historical)" if historical else ""))
+                    elif how in ("text changed", "file missing at one end"):
+                        left.append("%s %s %s (%s)" % (sec, bid, m.group(0), how))
+                return new[:-1]
+            new = CITE.sub(one, cur)
+            if new != cur:
+                doc.set_field(sec, bid, "source", cur, new)
+    # a carried citation the layer-3 closer re-read by hand is accepted only where the file it now points into is
+    # byte-identical to the one that was read; every other one waits for a person (--accept-rewritten after reading)
+    reviewed, unreviewed = [], []
+    for r in rewritten:
+        m = re.match(r"^(\S+) (\S+) (\S+):(\d+)-(\d+)", r)
+        path_ = m.group(3) if m else None
+        sha_ = sha16_text("\n".join(fn[path_])) if path_ in fn and fn[path_] is not None else None
+        key_ = r.replace(" (kept, historical)", "")
+        (reviewed if sha_ and sha_ in REVIEWED_CITES.get(key_, []) else unreviewed).append(r)
+    if reviewed:
+        log.append(("applied", "reanchor", "%d re-read" % len(reviewed),
+                    "carried citations the layer-3 closer re-read by hand on these very files"))
+    if REPORT[0] and rewritten:
+        # the reader's aid: each carried citation's text as read at `frm` beside the text now at its new position
+        out = ["# Citations carried positionally, for a hand re-read (%s -> %s at HEAD %s)" % (frm, "the tree", to), "",
+               "Each entry: the record, the citation as it was, the lines at %s, then the lines the citation now names. "
+               "Accept it when the new lines still say what the record relies on; else correct the record's source by "
+               "hand before running with --accept-rewritten." % frm, ""]
+        for r in rewritten:
+            m = re.match(r"^(\S+) (\S+) (\S+):(\d+)-(\d+)", r)
+            if not m:
+                continue
+            sec, bid, path, a, b = m.group(1), m.group(2), m.group(3), int(m.group(4)), int(m.group(5))
+            old = fo.get(path) or []
+            new = fn.get(path) or []
+            a2, b2, how = map_citation(old, new, mp.get(path, {}), a, b) if old and new else (None, None, "missing")
+            out.append("## %s %s: %s:%d-%d -> %s (file %s%s)" % (
+                sec, bid, path, a, b, "%d-%d" % (a2, b2) if a2 else how, sha16_text("\n".join(new)) if new else "-",
+                ", re-read by the layer-3 closer" if r in reviewed else ""))
+            out.append("")
+            out.append("At %s:" % frm)
+            out += ["    " + x[:600] for x in old[a - 1:b]]
+            out.append("")
+            out.append("Now:")
+            out += ["    " + x[:600] for x in (new[a2 - 1:b2] if a2 else [])]
+            out.append("")
+        open(REPORT[0], "w", encoding="utf-8").write("\n".join(out) + "\n")
+        log.append(("applied", "citation report", str(len(rewritten)), REPORT[0][-40:]))
+    if unreviewed and not accept_rewritten:
+        raise Refused("re-read these citations, whose text was rewritten where it stood, then run again with "
+                      "--accept-rewritten (--citation-report FILE writes each one's old and new text):\n  " +
+                      "\n  ".join(unreviewed))
+    doc.set_top("sources_read_at", frm, to)
+    for x in left:
+        log.append(("left", "reanchor", x[:60], ""))
+    log.append(("applied", "reanchor", "%s -> %s" % (frm, to), "%d rewritten in place, %d left" % (len(rewritten), len(left))))
+    return rewritten
+
+
+def conops_pin(doc, root, repin, log):
+    path = None; pin = None
+    for l in doc.lines:
+        if l.startswith("needs_document:"):
+            path = l.split(":", 1)[1].strip().strip('"')
+        if l.startswith("needs_document_sha256:"):
+            pin = l.split(":", 1)[1].strip()
+    have = hashlib.sha256(open(os.path.join(root, path), "rb").read()).hexdigest()
+    if have == pin:
+        log.append(("skip", "conops pin", have[:16], "matches"))
+        return
+    sys.path.insert(0, os.path.join(root, "v2/ecad/tools"))
+    import yaml
+    import rules_lib
+    quoted = {n["id"]: " ".join(n["statement"].split()) for n in yaml.safe_load(doc.text())["needs"]}
+    published = rules_lib.conops_needs(os.path.join(root, path))
+    if quoted != published:
+        raise Refused("%s's needs table differs from the quoted needs: re-read it by hand" % path)
+    if not repin:
+        raise Refused("%s is %s and the pin is %s; its needs table matches the quoted needs. Read the document's diff "
+                      "(sections 4, 4a and 5 feed REQ-014, REQ-018, REQ-025 and REQ-052), then run again with "
+                      "--repin-conops" % (path, have[:16], pin[:16]))
+    doc.set_top("needs_document_sha256", pin, have)
+    log.append(("applied", "conops pin", pin[:16] + " -> " + have[:16], "needs table unchanged"))
+
+
+def run_file_ops(root, fops, log, write):
+    for f in fops:
+        p = os.path.join(root, f["path"])
+        t = OVERLAY.get(f["path"]) or open(p, encoding="utf-8").read()
+        if f["new"] in t and f["old"] not in t:
+            log.append(("skip", "file", f["path"], f["new"][:50])); continue
+        if t.count(f["old"]) != 1:
+            raise Refused("%s: expected once, found %d times: %r" % (f["path"], t.count(f["old"]), f["old"][:120]))
+        t = t.replace(f["old"], f["new"])
+        OVERLAY[f["path"]] = t
+        if write:
+            open(p, "w", encoding="utf-8").write(t)
+        log.append(("applied", "file", f["path"], f["new"][:50]))
+
+
+def main(argv):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--root", default=None, help="repository root (default: git top level of the current directory)")
+    ap.add_argument("--dry-run", action="store_true", help="apply in memory and report, write nothing")
+    ap.add_argument("--no-reanchor", action="store_true", help="leave the file:line citations where they are")
+    ap.add_argument("--accept-rewritten", action="store_true",
+                    help="after reading them: carry citations whose text was rewritten in place")
+    ap.add_argument("--repin-conops", action="store_true",
+                    help="after reading CONOPS's diff: re-pin needs_document_sha256 when its needs table is unchanged")
+    ap.add_argument("--skip-files", action="store_true", help="registry only; leave the pack and facts files")
+    ap.add_argument("--no-install", action="store_true",
+                    help="do not file the cited documents and SOURCES.yaml blocks from the drafts beside this script "
+                         "(the closer's own worktree, which does not own v2/vendor); they stay in companion_documents")
+    ap.add_argument("--citation-report", default=None, metavar="FILE",
+                    help="write every citation carried positionally (its text rewritten in place) with its old and new "
+                         "text, for the hand re-read --accept-rewritten asks for")
+    a = ap.parse_args(argv)
+    REPORT[0] = a.citation_report
+    root = a.root or repo_root(os.getcwd())
+    if not root:
+        print("apply_registry: run inside the repository or pass --root"); return 2
+    reg = os.path.join(root, "v2/ecad/tools/pcb_requirements.yaml")
+    doc = Doc(open(reg, encoding="utf-8").read())
+    log = []
+    ROOT_FOR_OPS[0] = root
+    WRITE_FILES[0] = not a.dry_run
+    DRY_RUN[0] = a.dry_run
+    try:
+        ids = resolve(doc, OPS)
+        if not a.no_install:
+            run_vendor(root, VENDOR, log, write=not a.dry_run)
+        if not a.skip_files:
+            run_file_ops(root, subst(FILE_OPS, ids), log, write=not a.dry_run)
+        run_ops(doc, subst(OPS, ids), log)
+        prune_companions(doc, root, log)
+        if not a.no_reanchor:
+            reanchor(doc, root, log, a.accept_rewritten)
+        conops_pin(doc, root, a.repin_conops, log)
+    except Refused as e:
+        for r in log:
+            print("%-8s %-22s %-14s %s" % r)
+        print("REFUSED: %s" % e)
+        print("apply_registry: nothing written")
+        return 1
+    for r in log:
+        print("%-8s %-22s %-14s %s" % r)
+    print("apply_registry: ids " + ", ".join("%s=%s" % (k.strip("@"), v) for k, v in sorted(ids.items(), key=lambda x: x[1])))
+    applied = sum(1 for r in log if r[0] == "applied")
+    if a.dry_run:
+        print("apply_registry: dry run, %d change(s) would be made" % applied); return 0
+    open(reg, "w", encoding="utf-8").write(doc.text())
+    print("apply_registry: %d change(s) written to %s. Next: (cd v2/ecad/tools && python3 rules_lib.py requirements "
+          "&& python3 rules_render.py --requirements)" % (applied, os.path.relpath(reg, root)))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
