+def list_field_items(text):
+    """The items of an inline or block list field, as written (quotes kept)."""
+    lines = text.split("\n")
+    m = re.match(r"^\s*[A-Za-z_]+:\s*\[(.*)\]\s*$", lines[0])
+    if m:
+        inner = m.group(1).strip()
+        return [x.strip() for x in re.findall(r'"[^"]*"|[^,]+', inner) if x.strip()] if inner else []
+    return None
