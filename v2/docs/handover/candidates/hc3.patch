+def reanchor_source_entry(s, root, from_commit, files_old, files_new, maps, historical=False):
+    """Re-anchor every file:line in one source string. Returns (new string, list of (path, a, b, how)). In a
+    HISTORICAL record (superseded or conflict: it cites what a source said) a citation whose text was rewritten keeps
+    its line and says which commit it was read at, instead of pointing at the corrected text."""
+    notes = []
+
+    def sub(m):
+        end = s.find('"', m.end())
+        tail = s[m.end():end if end >= 0 else len(s)]
+        if re.search(r"\bat [0-9a-f]{7,}\b", tail):
+            notes.append((m.group(1), 0, 0, "explicitly anchored"))
+            return m.group(0)
+        path, a = m.group(1), int(m.group(2))
+        b = int(m.group(3) or a)
+        if path not in files_old:
+            files_old[path] = git_show(root, from_commit, path)
+            try:
+                files_new[path] = open("%s/%s" % (root, path), encoding="utf-8").read().split("\n")
+            except OSError:
+                files_new[path] = None
+            if files_old[path] is not None and files_new[path] is not None:
+                maps[path] = line_map(files_old[path], files_new[path])
+        old, new = files_old.get(path), files_new.get(path)
+        if old is None or new is None:
+            notes.append((path, a, b, "file missing at one end"))
+            return m.group(0)
+        if old == new:
+            return m.group(0)
+        a2, b2, how = map_citation(old, new, maps[path], a, b)
+        if a2 is None:
+            notes.append((path, a, b, how))
+            return m.group(0)
+        notes.append((path, a, b, how))
+        if historical and how == "rewritten in place":
+            return m.group(0) + " (as read at %s)" % from_commit
+        return "%s:%d" % (path, a2) + ("-%d" % b2 if m.group(3) else "")
+    return CITE.sub(sub, s), notes
