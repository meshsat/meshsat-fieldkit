+PLACE = re.compile(r"@(SC|S|REQ|CON|CFL|ASM):([a-z0-9-]+)@")
+ID_FMT = {"SC": "SC-%02d", "S": "S-%02d", "REQ": "REQ-%03d", "CON": "CON-%03d", "CFL": "CFL-%03d", "ASM": "ASM-%03d"}
