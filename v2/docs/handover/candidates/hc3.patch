+def resolve(doc, ops):
+    """Placeholder -> id. A placeholder whose defining block is already in the registry (found by its fingerprint)
+    keeps that block's id, so a second run changes nothing; the others take the next free number of their prefix."""
+    found, order = {}, []
+    for op in ops:
+        for v in op.values():
+            for m in PLACE.finditer(v if isinstance(v, str) else json.dumps(v)):
+                if m.group(0) not in order:
+                    order.append(m.group(0))
+    defining = {}
+    for op in ops:
+        if op["op"] == "add_block":
+            m = re.match(r"^  - id: (@[A-Z]+:[a-z0-9-]+@)", op["text"])
+            if m:
+                defining[m.group(1)] = op
+    for tok in order:
+        pre = PLACE.match(tok).group(1)
+        op = defining.get(tok)
+        if op is None:
+            raise Refused("placeholder %s has no defining block" % tok)
+        for bid, bs, be in doc.blocks(op["section"]):
+            if norm(op["fingerprint"]) in norm("\n".join(doc.lines[bs:be])):
+                found[tok] = bid
+                break
+    # new ids follow the order the blocks are written in the registry: layer 1's choices, then layer 2's, then layer 3's
+    op_index = {}
+    for i, o in enumerate(ops):
+        m = re.match(r"^  - id: (@[A-Z]+:[a-z0-9-]+@)", o.get("text", "")) if o["op"] == "add_block" else None
+        if m:
+            op_index.setdefault(m.group(1), i)
+
+    def prio(tok):
+        tag = PLACE.match(tok).group(2)
+        return (0 if tag.startswith("hc1-") else 1 if tag.startswith("l2-") else 2, op_index.get(tok, 10 ** 6))
+    order = sorted(order, key=prio)
+    nxt = {}
+    for tok in order:
+        if tok in found:
+            continue
+        pre = PLACE.match(tok).group(1)
+        if pre not in nxt:
+            taken = existing_ids(doc, pre) + [int(re.search(r"(\d+)$", v).group(1)) for k, v in found.items()
+                                              if PLACE.match(k).group(1) == pre]
+            nxt[pre] = max(taken or [0]) + 1
+        found[tok] = ID_FMT[pre] % nxt[pre]
+        nxt[pre] += 1
+    return found
