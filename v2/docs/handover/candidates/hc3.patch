+def existing_ids(doc, prefix):
+    secs = {"SC": ["session_choices"], "S": ["open_items", "closed_items"]}.get(prefix, ["records"])
+    out = []
+    for s in secs:
+        for bid in doc.ids(s):
+            m = re.match(r"^%s-(\d+)$" % prefix, bid)
+            if m:
+                out.append(int(m.group(1)))
+    return out
