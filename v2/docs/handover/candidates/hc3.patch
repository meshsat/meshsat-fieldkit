+def map_citation(old, new, lmap, a, b):
+    """Map 1-based lines a..b of `old` into `new`. (a', b', how) or (None, None, reason)."""
+    idx = list(range(a - 1, b))
+    if all(i in lmap for i in idx) and all(lmap[idx[k]] == lmap[idx[0]] + k for k in range(len(idx))):
+        return lmap[idx[0]] + 1, lmap[idx[-1]] + 1, "moved" if lmap[idx[0]] != idx[0] else "same"
+    block = old[a - 1:b]
+    if block and any(x.strip() for x in block):
+        hits = [j for j in range(len(new) - len(block) + 1) if new[j:j + len(block)] == block]
+        if len(hits) == 1:
