+def op_list_add(doc, sec, bid, field, item, after):
+    cur = doc.get_field(sec, bid, field)
+    if cur is None:
+        for a in (after, "rule_coverage", None):
+            if a is None or doc.field_range(sec, bid, a) is not None:
+                return doc.set_field(sec, bid, field, None, "    %s: [%s]" % (field, item), after=a)
+    items = list_field_items(cur)
+    if items is not None:
+        if item in items or item.strip('"') in [i.strip('"') for i in items]:
+            return "skip"
+        new = cur.split("\n")[0].rstrip()
+        new = new[:-1] + (", " if items else "") + item + "]"
+        if len(new) > 120 and item.startswith('"'):
+            ind = re.match(r"^(\s*)", cur).group(1)
+            new = "\n".join([ind + field + ":"] + [ind + "  - " + i for i in items + [item]])
+        return doc.set_field(sec, bid, field, cur, new)
+    # block list
+    if norm(item.strip('"')) in norm(cur):
+        return "skip"
+    ind = re.match(r"^(\s*)", cur).group(1)
+    return doc.set_field(sec, bid, field, cur, cur + "\n" + ind + "  - " + item)
+
+
+def op_list_remove(doc, sec, bid, field, item):
+    cur = doc.get_field(sec, bid, field)
+    if cur is None:
+        return "skip"
+    items = list_field_items(cur)
+    if items is None:
+        raise Refused("%s %s: %s is a block list; list_remove handles inline lists only" % (sec, bid, field))
+    if item not in items:
+        return "skip"
+    rest = [i for i in items if i != item]
+    new = None if not rest else re.sub(r"\[.*\]", "[%s]" % ", ".join(rest), cur.split("\n")[0])
+    return doc.set_field(sec, bid, field, cur, new)
+
+
+def op_rules_add(doc, sec, bid, rule):
+    cur = doc.get_field(sec, bid, "satisfied_by")
+    if cur is None:
+        raise Refused("%s %s: no satisfied_by" % (sec, bid))
+    lines = cur.split("\n")
+    for i, l in enumerate(lines):
+        m = re.match(r"^(\s+)rules:\s*\[(.*)\]\s*$", l)
+        if m:
+            items = [x.strip() for x in m.group(2).split(",") if x.strip()]
+            if rule in items:
+                return "skip"
+            lines[i] = "%srules: [%s]" % (m.group(1), ", ".join(items + [rule]))
+            return doc.set_field(sec, bid, "satisfied_by", cur, "\n".join(lines))
+    raise Refused("%s %s: satisfied_by has no inline rules list" % (sec, bid))
