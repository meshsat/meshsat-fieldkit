+def subst(obj, ids):
+    if isinstance(obj, str):
+        return PLACE.sub(lambda m: ids[m.group(0)], obj)
+    if isinstance(obj, list):
+        return [subst(x, ids) for x in obj]
+    if isinstance(obj, dict):
+        return {k: subst(v, ids) for k, v in obj.items()}
+    return obj
