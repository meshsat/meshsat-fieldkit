+#!/usr/bin/env python3
+"""Apply the layer-3 closer's registry change (MESHSAT-1357, 27 September 2026) BY RECORD ID, with asserted
+old text, to v2/ecad/tools/pcb_requirements.yaml (and, unless --skip-files, the CFL-003 and CFL-006 source fixes of
+pcb_board_facts.yaml, pcb_pack_protection.yaml and pcb_energy_chain.yaml). Idempotent: a second run changes nothing.
+
+Generated by drafts/hc3/author.py from the registry at e3aedb25; do not edit by hand.
+
+It also files the four documents the new pass lines cite (drafts/hc3/vendor/, sha256 checked) and appends the
+SOURCES.yaml blocks of the layer-1 and layer-3 closers (documents_filed_hc1, documents_filed_hc3), which is step 0
+of fnd/hc1's apply_hc1_registry.py: run THIS script instead of that one (--no-install skips the filing).
+
+Order at integration (drafts/hc3/README.md): merge the other branches and commit the merged documents first, so
+the re-anchoring can name that commit; run this from the repository root with --dry-run; read what it reports;
+run it; then `python3 rules_lib.py requirements` and `python3 rules_render.py --requirements` in v2/ecad/tools.
+New ids (SC, S, REQ, CON, CFL) are taken from the next free number at apply time; a block already present (found
+by its own text) keeps its id."""
+import re
+import subprocess
+import difflib
+import hashlib
+import os
+
+
+SECTIONS = ("owner_rulings", "session_choices", "open_items", "closed_items", "records")
+
+
+def norm(s):
+    return " ".join(str(s or "").split())
+
+
+class Refused(Exception):
+    pass
+
+
+class Doc:
+    def __init__(self, text):
+        self.lines = text.split("\n")
+
+    def text(self):
+        return "\n".join(self.lines)
+
+    # ---- structure
+    def section_range(self, name):
+        start = None
+        for i, l in enumerate(self.lines):
+            if l.startswith(name + ":"):
+                start = i
+                break
+        if start is None:
+            raise Refused("no top-level section %s" % name)
+        end = len(self.lines)
+        for j in range(start + 1, len(self.lines)):
+            l = self.lines[j]
+            if l and not l.startswith(" ") and not l.startswith("#"):
+                end = j
+                break
+        # a comment block that introduces the NEXT section belongs to it, not to this one
+        while end > start + 1 and (self.lines[end - 1].startswith("#") or not self.lines[end - 1].strip()):
+            end -= 1
+        return start, end
+
+    def blocks(self, section):
+        s, e = self.section_range(section)
+        out, cur = [], None
+        for i in range(s + 1, e):
+            m = re.match(r"^  - id: (\S+)\s*$", self.lines[i])
+            if m:
+                if cur:
+                    out.append(cur)
+                cur = [m.group(1).strip('"'), i, i + 1]
+            elif cur:
+                cur[2] = i + 1
+        if cur:
+            out.append(cur)
+        res = []
+        for bid, bs, be in out:
+            while be > bs + 1 and not self.lines[be - 1].strip():
+                be -= 1
+            res.append((bid, bs, be))
+        return res
+
+    def ids(self, section):
+        return [b[0] for b in self.blocks(section)]
+
+    def block(self, section, bid):
+        for b in self.blocks(section):
+            if b[0] == bid:
+                return b
+        raise Refused("%s: no block %s" % (section, bid))
+
+    def has(self, section, bid):
