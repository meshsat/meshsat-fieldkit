+    p("   target drives, never in a START, STOP or their own address (INFERRED, bench V-K03)")
+    p("")
+    p("SOURCES")
+    for k, v in SRC.items(): p("   %s: %s" % (k, v))
+    print("\n".join(out))
+    return 0
