+# ------------------------------------------------------------------ the makers' ranges
+def lin(v, a3, a45): return a3 + (a45 - a3) * (v - 3.0) / 1.5
+def tlimits(V):
+    """74LVC1G17 limits at supply V (Diodes DS35124 Rev 8-2 p.5, -40 to +125 C): the MINIMA are the 3 V row's at every V (the
