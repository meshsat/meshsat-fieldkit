+        if n in self.watch: self.log.setdefault(n, []).append((t, v))
+        for g in self.readers.get(n, []):
+            if "kind" in g:
+                if self.hazard and g["kind"] == "mux" and n == g["in"][0] and self.net.get(g["in"][1], 0) and self.net.get(g["in"][2], 0):
