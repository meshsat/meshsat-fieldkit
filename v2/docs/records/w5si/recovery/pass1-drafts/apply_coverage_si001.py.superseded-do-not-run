#!/usr/bin/env python3
"""DRAFT (stream w5si, 27 September 2026, MESHSAT-1357, layer 9): SI-001's coverage record says what the reading now is.

Record SI-001 of v2/ecad/tools/pcb_rules_coverage.yaml: a paragraph appended to its note (the edge rates as data, the
readings before and after on the committed netlists at c23c5e76) and its remediation's action, owner and execution
replaced (what is left is schematic and desk work, plus measurements where only a bound decides).

Applied on the integrated tree (after set 6), from the repository root:
    python3 drafts/w5si/apply_coverage_si001.py [--root <tree>]
It finds record SI-001 by its id, asserts the remediation text it replaces, inserts the paragraph at the end of the
note, re-parses the YAML and checks the record. If the integration re-took SI-001 after c23c5e76, re-derive the
readings sentence from edge_length.py on the integrated netlists before applying (the numbers are this stream's).
"""
import os, sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
if "--root" in sys.argv: ROOT = os.path.abspath(sys.argv[sys.argv.index("--root") + 1])
TARGET = os.path.join(ROOT, "v2", "ecad", "tools", "pcb_rules_coverage.yaml")

OLD_REM = ('",\n   remediation: {action: "decision 39 rules the criterion k as a declared calibration (21 September 2026), so '
           'the whole of what is left is an edge rate for the classes whose drivers publish none')
OLD_TAIL = ('A direct question to a vendor is the only shortcut and nobody has asked one", owner: LAB, execution: HARDWARE, '
            'depends_on: [],')

PARA = (
    "\n     27 September 2026 (stream w5si, MESHSAT-1357, layer 9): THE EDGE RATES ARE DATA. tools/pcb_edge_rates.yaml, a"
    " configuration input of the edge_length verdict recorded by sha, holds every edge the reading uses, each with the"
    " maker's document, the words quoted from it, the conditions, the applicability and the verification owed: interface"
    " records that decide a class entry (the two USB 2.0 minimums that were EDGE_SOURCES; instantaneous bounds for board"
    " B's controlled links, the RF lines, the power-stage nodes and the oscillator nodes), driver families matched by the"
    " part number at the start of the netlist's value field (never an order code), and far ends. A family is the maker's"
    " IBIS model read per pin by tools/ibis_read.py (13 models filed under v2/vendor/ti/ibis and v2/vendor/st/ibis: TI's"
    " LVC gates 0.113 to 0.282 ns, the PCA9555's INT fall 0.121 ns, the STM32H743's 0.451 ns at its very-high-speed"
    " setting, the TCAN334's RXD 1.57 ns, the ADS1115's SDA 0.786 ns, each the 20 to 80 percent time at the fastest"
    " corner, not stretched), a published minimum per pin (TPS25740 CC 300 ns and digital outputs 20 ps, TPS23861 SDAO"
    " 21 ns, DS3231 SDA 20 ns, PI7C9X2G404SL REFCLKO 175 ps) or, where the maker publishes none, the instantaneous bound"
    " with the documents checked; a published typical or maximum is refused as an edge (the STM32H743's Table 53 gives"
    " only maxima). A net whose driver has no record stays UNDECIDED and names it; a net that leaves through a connector"
    " takes its far end (the kit's board-to-board nets from the continued boards' own netlists, pin by pin); a net one"
    " series resistor from a driven net takes that net's drivers. A layout-bound net that no maker's figure on it holds"
    " is named BOUND_DECIDES and holds the reading INCONCLUSIVE; one a maker's figure holds is the maker's. Session"
    " decisions ER-D1 to ER-D12 are in the data file's header. Readings in the stream's scratch on the committed"
    " netlists at c23c5e76 (before, then after): decided nets A 6 then 82, B 30 then 553, C 4 then 33, D 20 then 39, E 4"
    " then 41, P 0 then 5; undecided 114 then 38, 532 then 9, 33 then 4, 27 then 8, 37 then 0, 22 then 17 (what remains"
    " is the 75 nets no signal-class declaration names and board B's BOB, a Bob Smith termination node no part drives);"
    " layout-bound 0 then 63, 0 then 193, 0 then 23, 2 then 13, 0 then 31, 0 then 1, of which a maker's figure holds 5,"
    " 67, 6, 5, 0, 0 and only a bound decides 58, 126, 17, 8, 31, 1. All six stay INCONCLUSIVE, now for named reasons."
    " The maker-held include board B's voters and supervisor lines (LVC 0.11 to 0.22 ns and the STM32H743 at 0.45 ns:"
    " critical lengths 2.6 to 10.5 mm on the slowest layer), its CAN lines to the TCAN334s (10.5 mm) and the kit I2C bus"
    " and EXP_INT on boards A to D (the STM32H743's I2C1 pins at 0.45 ns and the PCA9555's INT at 0.12 ns, on a bus of"
    " about 1.5 m of copper and 490 mm of ribbon). The bound-decided are power-stage and oscillator nodes, modules and"
    " bridges whose makers publish no edge, and bench headers; none of them decides feasibility, because each has a"
    " schematic answer (a termination at the driver, an impedance class, a firmware obligation that slows the driver, or"
    " a declaration) that makes its verdict independent of the edge; which answer each takes is open design work.")

NEW_REM = ('",\n   remediation: {action: "since the edge rates became data (27 September 2026, stream w5si) what is left is'
           ' design and desk work: a schematic answer per layout-bound net (an impedance target, a series termination at'
           ' the driver, a firmware obligation that slows the driver, or an edge_allow declaration naming what holds its'
           ' length), a signal-class declaration for each of the 75 nets that carry none, and, where only a bound decides,'
           ' the maker\'s IBIS model the runner could not fetch (Nexperia, Diodes, Microchip, Winbond) or the edge measured'
           ' at bring-up", owner: SESSION, execution: PARALLEL_AGENT, depends_on: [],')


def main():
    s = open(TARGET, encoding="utf-8").read()
    a = s.index("\n SI-001: {")
    b = s.index("\n CLK-001: {", a)
    rec = s[a:b]
    assert "THE EDGE RATES ARE DATA" not in rec, "already applied"
    assert rec.count(OLD_REM) == 1, "SI-001's remediation no longer opens as written: re-read the record"
    i = rec.index(OLD_REM)
    j = rec.index(OLD_TAIL, i)
    rec2 = rec[:i] + PARA + NEW_REM + rec[j + len(OLD_TAIL):]
    out = s[:a] + rec2 + s[b:]
    import yaml
    d = yaml.safe_load(out)
    r = d["coverage"]["SI-001"]
    assert "THE EDGE RATES ARE DATA" in r["note"] and r["remediation"]["owner"] == "SESSION", r["remediation"]
    assert r["verification"]["tool"] == "edge_length.py" and r["remediation"]["_depends_why"].startswith("NOT RET-001")
    open(TARGET, "w", encoding="utf-8").write(out)
    print("pcb_rules_coverage.yaml SI-001: note extended, remediation replaced")


if __name__ == "__main__":
    main()
